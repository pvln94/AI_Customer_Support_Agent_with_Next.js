# LAYMAN: Blank template of every setting the app needs — copy to .env.local and fill in your own keys (this file is public, so it must never hold real secrets).
# TEMPLATE ONLY — NEVER put real keys or passwords in this file (it goes to GitHub).
# Real values belong in .env.local (gitignored, stays on your machine).
# Groq free tier (what I use). Never hardcode a model name.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
# Other OpenAI-compatible presets (swap the 3 lines above + key in .env.local):
# OpenAI:            LLM_BASE_URL=https://api.openai.com/v1
# Google AI Studio:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                    (check current model name; old ones retire)

# MongoDB
MONGODB_URI=mongodb://localhost:27017/refund-agent
# Optional: separate DB for integration tests when mongodb-memory-server binary cannot download
# MONGODB_TEST_URI=mongodb://localhost:27017/refund-agent-test

# Admin Basic Auth (used by proxy.ts for /admin and /api/admin/*)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-in-env-local

# Optional: force N transient tool failures to demo retries, e.g. "getOrderDetails:1"
# SIMULATE_FAILURE=
